{
  "name": "yet-another-markdown-editor",
  "displayName": "Yet Another Markdown Editor",
  "description": "Edit Markdown in a rendered block canvas with formatting, block actions, and emoji autocomplete.",
  "version": "0.1.5",
  "publisher": "akiyamasho",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akiyamasho/yet-another-markdown-editor.git"
  },
  "homepage": "https://github.com/akiyamasho/yet-another-markdown-editor#readme",
  "bugs": {
    "url": "https://github.com/akiyamasho/yet-another-markdown-editor/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "gfm",
    "emoji",
    "blocks"
  ],
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "activationEvents": [
    "onCustomEditor:yetAnotherMarkdown.editor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "yetAnotherMarkdown.editor",
        "displayName": "Yet Another Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "yetAnotherMarkdown.openSource",
        "title": "Yet Another Markdown Editor: Open Source"
      },
      {
        "command": "yetAnotherMarkdown.addSelectionToCodex",
        "title": "Add Rendered Selection to Codex Thread",
        "category": "Yet Another Markdown Editor"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "yetAnotherMarkdown.addSelectionToCodex",
          "when": "webviewId == 'yetAnotherMarkdown.editor'",
          "group": "codex@1"
        }
      ]
    },
    "configuration": {
      "title": "Yet Another Markdown Editor",
      "properties": {
        "yetAnotherMarkdownEditor.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save edits made in the visual editor."
        },
        "yetAnotherMarkdownEditor.showSourceOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Open Markdown in the source editor instead of the visual editor."
        },
        "yetAnotherMarkdownEditor.debounceMs": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay before visual-editor changes are written to the document."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "watch": "node esbuild.js --watch",
    "package": "npm run build && vsce package --readme-path MARKETPLACE.md --githubBranch main --out yet-another-markdown-editor.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "7.22.1"
  }
}
